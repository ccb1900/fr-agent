{
  "outName": "生产日报G4",
  "reportName": "生产日报（web 验证 G4：自定义 tooltip）",
  "dataset": {
    "kind": "sql",
    "connection": "ATOM_LIVE",
    "entity": "InspectionRecord",
    "dimensions": ["bizDate", "machine"],
    "metrics": ["planned", "done", "completionRate"],
    "dateRange": { "from": "2026-09-13", "to": "2026-09-22" }
  },
  "presentation": {
    "type": "table",
    "showTotal": true,
    "chart": {
      "kind": "vbar",
      "category": "bizDate",
      "value": "planned",
      "title": "每日计划数",
      "tooltip": {
        "muti": false,
        "formats": { "value": "#,##0" },
        "richText": { "content": "自定义提示 系列=${SERIES} 值=${VALUE}", "auto": true }
      }
    }
  }
}
