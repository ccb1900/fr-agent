<TableDataMap>
<TableData name="ds1" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters/>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>
<![CDATA[ATOM_LIVE]]></DatabaseName>
</Connection>
<Query>
<![CDATA[SELECT convert(varchar(10), TRY_CAST(laser_aaa.biz_date AS date), 23) AS bizDate, laser_files.source_id AS machine, COUNT(*) AS planned, SUM(CASE WHEN TRY_CAST(laser_aaa.score AS float) >= 0.9 THEN 1 ELSE 0 END) AS done FROM laser_aaa INNER JOIN laser_files ON laser_aaa.file_key = laser_files.file_key WHERE TRY_CAST(laser_aaa.score AS float) IS NOT NULL AND TRY_CAST(laser_aaa.biz_date AS date) BETWEEN '2026-09-13' AND '2026-09-22' GROUP BY TRY_CAST(laser_aaa.biz_date AS date), laser_files.source_id ORDER BY 1]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
</TableDataMap>
