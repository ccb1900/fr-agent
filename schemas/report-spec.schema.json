{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "fr-agent ReportSpec (datasets: rows | sql)",
  "description": "声明式机器契约（文档 + 未来外部工具面）。注意：Nashorn ES5 运行期无 JSON-Schema 校验库，实际执行者是 lib/spec_validator.js（与 lib/ir.js 手写校验同先例，README #55 留痕）。本 schema 与 spec_validator 必须同步演进；spec_validator 是权威，本文件是它的可读镜像（I1.1 起按 rows/sql 两种数据集如实分列）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["outName", "dataset"],
  "properties": {
    "specVersion": { "type": "string", "enum": ["1"], "description": "缺省视为当前版；未知版被 spec_validator 拒（UNSUPPORTED_SPEC_VERSION）" },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "报表标题（编译进 IR title）" },
        "description": { "type": "string" }
      }
    },
    "outName": { "type": "string", "description": "裸文件名，禁路径分隔/.. /盘符（INVALID_PATH 闸）；落目录由 BR_DEPLOYDIR env 控制，spec 无权指路径" },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "description": "rows 数据集专用：分组键，恒 text 列，不得带 aggregation（sql 路把维度名写在 dataset.dimensions）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "label"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "widthPt": { "type": "number" },
          "format": { "type": "string" }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "description": "rows 数据集专用：度量列，聚合仅 sum；avg/count/min/max/ratio_of_sums=已规划未实现（UNSUPPORTED_CAPABILITY）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "label", "aggregation"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "aggregation": { "type": "string", "enum": ["sum", "avg", "average", "count", "min", "max", "ratio_of_sums"], "x-implemented": ["sum"] },
          "dataType": { "type": "string", "enum": ["text", "number", "integer", "long", "float", "decimal"], "default": "number" },
          "widthPt": { "type": "number" },
          "format": { "type": "string" }
        }
      }
    },
    "dataset": {
      "description": "两种形态（互斥）：① rows=内嵌数据（I1 基线）；② kind=sql=模型驱动（引用 Semantic Model 维度/指标名，SQL 由 sqlbuilder 生成，禁自由文本 query）",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows"],
          "properties": {
            "rows": { "type": "array", "items": { "type": "array" }, "description": "每行列数须等于 dimensions+metrics 总数（INVALID_SHAPE）" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entity", "connection"],
          "properties": {
            "kind": { "type": "string", "enum": ["sql"] },
            "entity": { "type": "string", "description": "Semantic Model 实体名（须在 model 中存在）" },
            "connection": { "type": "string", "description": "数据连接名；凭据只在本机 runner dbpass，JSON/cpt 零凭据" },
            "schema": { "type": "string", "description": "I2 schema 快照名（缺省取 model.source）" },
            "dimensions": { "type": "array", "items": { "oneOf": [{ "type": "string" }, { "type": "object", "additionalProperties": false, "required": ["term"], "properties": { "term": { "type": "string" }, "label": { "type": "string" }, "widthPt": { "type": "number" } } }] }, "description": "模型维度名；可带 {term,label,widthPt} 覆盖表头文案/列宽" },
            "metrics": { "type": "array", "items": { "oneOf": [{ "type": "string" }, { "type": "object", "additionalProperties": false, "required": ["term"], "properties": { "term": { "type": "string" }, "label": { "type": "string" }, "widthPt": { "type": "number" } } }] }, "description": "模型指标名；可带 {term,label,widthPt} 覆盖表头文案/列宽" },
            "dateRange": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {
                "from": { "type": "string", "description": "yyyy-MM-dd，严格双边 + 日历有效性（IsoDate 单点）" },
                "to": { "type": "string", "description": "yyyy-MM-dd，from<=to" }
              }
            },
            "filters": {
              "type": "array",
              "description": "受控字面量筛选（数值列须有限数、文本列须安全 token、op×类型受约束）",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["field", "value"],
                "properties": {
                  "field": { "type": "string" },
                  "op": { "type": "string", "description": "==/!=/>/>=/</<=/like/contains（映射与列型约束见 sqlbuilder）" },
                  "value": { "type": ["string", "number"] }
                }
              }
            },
            "sort": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["field"],
                "properties": {
                  "field": { "type": "string", "description": "已选 SQL 列别名（派生比率列不可排）" },
                  "dir": { "type": "string", "enum": ["asc", "desc"], "default": "asc" }
                }
              }
            },
            "topN": {
              "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "object", "additionalProperties": false, "required": ["n"], "properties": { "n": { "type": "integer", "minimum": 1 } } }],
              "description": "SELECT TOP n；须配 sort（否则无确定序→拒）"
            }
          },
          "anyOf": [
            { "required": ["dimensions"] },
            { "required": ["metrics"] }
          ]
        }
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "description": "键白名单 {type,showTotal,heightsPt,chart,footnote,conditions,cells,total}；未知键→UNSUPPORTED_CAPABILITY（写了不生效故拒）",
      "properties": {
        "type": { "type": "string", "enum": ["table"], "default": "table" },
        "showTotal": { "type": "boolean", "default": true },
        "footnote": { "type": "string", "description": "脚注文案（两路均发射 space+cells 行；缺省不发射）" },
        "conditions": { "type": "array", "description": "rows 路单元格条件格式（sql 路拒）", "items": { "type": "object" } },
        "cells": { "type": "array", "description": "rows 路额外 cells 块（不支持绝对 r；sql 路拒）", "items": { "type": "object" } },
        "total": {
          "type": "object",
          "additionalProperties": false,
          "description": "合计行定制（rows 路；showTotal=false 时拒）",
          "properties": {
            "label": { "type": "string" },
            "sumCols": { "type": "array", "items": { "type": "object" } }
          }
        },
        "heightsPt": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "title": { "type": "number" }, "header": { "type": "number" }, "row": { "type": "number" }, "total": { "type": "number" } }
        },
        "chart": {
          "type": "object",
          "additionalProperties": false,
          "description": "仅 kind=sql 数据集支持（rows 路写→UNSUPPORTED_CAPABILITY，不静默丢图）；散点/气泡用 x/y，其余用 category/value",
          "if": { "properties": { "kind": { "enum": ["vscatter", "vbubble"] } }, "required": ["kind"] },
          "then": { "required": ["x", "y"] },
          "else": { "required": ["category", "value"] },
          "properties": {
            "kind": { "type": "string", "enum": ["bar", "pie", "line", "vbar", "vline", "varea", "vscatter", "vbubble", "vpie", "vgauge"], "default": "bar" },
            "category": { "type": "string", "description": "已选维度列别名" },
            "value": { "type": "string", "description": "基础度量列别名（派生比率不可作 value）" },
            "x": { "type": "string", "description": "散点/气泡 x 度量别名" },
            "y": { "type": "string", "description": "散点/气泡 y 度量别名" },
            "bubbleSize": { "type": "string", "description": "气泡大小度量列名（可选）" },
            "title": { "type": "string" },
            "heightPt": { "type": "number" },
            "tooltip": { "type": "object" }, "label": { "type": "object" }, "marker": { "type": "object" },
            "lineStyle": { "type": "object" }, "trend": { "type": "object" }, "stack": { "type": "object" },
            "conditions": { "type": "array" }, "alpha": { "type": "number" }, "bg": { "type": "number" },
            "border": { "type": "object" }, "axisY": { "type": "object" }, "axisX": { "type": "object" },
            "legend": { "type": "object" }, "barInterval": { "type": "number" },
            "hotTooltip": { "type": "object" }, "seriesBorder": { "type": "object" },
            "effect": { "type": "object" }, "areaFill": { "type": "object" }, "seriesImage": { "type": "object" }
          }
        }
      }
    },
    "params": {
      "type": "array",
      "description": "参数面板控件（B2/B6）：kind 白名单、name 唯一、value 标量；reg 支持 none|phone|idcard|mobile|postcard 或 {custom,err}",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string", "enum": ["label", "editor", "date", "combo", "number", "textarea", "radio", "checkbox", "combocheck", "treecombo", "nav", "iframe", "submit"] },
          "name": { "type": "string" },
          "label": { "type": "string" },
          "text": { "type": "string" },
          "value": { "type": ["string", "number", "boolean"] },
          "values": { "type": "array", "items": { "type": ["string", "number", "boolean"] } },
          "reg": {},
          "url": { "type": "string" },
          "bold": { "type": "boolean" },
          "sizePt": { "type": "number" },
          "allowDecimals": { "type": "boolean" },
          "maxValue": { "type": "number" },
          "minValue": { "type": "number" }
        }
      }
    },
    "sheet": {
      "type": "object",
      "description": "sheet 级扩展（B3/B4/C2）：headerFooter/floats/paper/hideRows/hideCols 为 sheet 级；watermark/toolbar 为 workbook 级（写在 sheet 对象便于阅读）",
      "additionalProperties": false,
      "properties": {
        "headerFooter": { "type": "object" },
        "floats": { "type": "array" },
        "paper": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "width": { "type": "number" }, "height": { "type": "number" }, "top": { "type": "number" }, "left": { "type": "number" }, "bottom": { "type": "number" }, "right": { "type": "number" } }
        },
        "watermark": { "type": "object" },
        "toolbar": { "type": "object" },
        "hideRows": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "hideCols": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      }
    },
    "extraSheets": {
      "type": "array",
      "description": "额外 sheet（rows 内嵌路）：每项 {name, dimensions, metrics, dataset:{rows}, presentation, sheet}；name 必填唯一且不得为 sheet1；SQL 路暂不支持（UNSUPPORTED_CAPABILITY）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "dataset"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "dimensions": { "type": "array" },
          "metrics": { "type": "array" },
          "dataset": { "type": "object", "description": "rows 形态（同顶层）；kind=sql 被拒" },
          "presentation": { "type": "object", "description": "同顶层 presentation（conditions/cells/total 可用）" },
          "sheet": { "type": "object", "description": "同顶层 sheet 扩展" }
        }
      }
    },
    "filters": { "x-unsupported": "顶层 filters 仍拒；sql 路放 dataset.filters", "type": "array" },
    "chart": { "x-unsupported": "顶层 chart 仍拒；sql 路放 presentation.chart", "type": "object" }
  },
  "x-scope": {
    "rows": {
      "supported": ["dimensions(text 分组键)", "metrics(sum 聚合)", "内嵌 dataset.rows", "presentation.table + showTotal + footnote", "presentation.conditions", "presentation.cells（无绝对 r）", "presentation.total{label,sumCols}", "params 参数面板", "sheet 扩展（headerFooter/floats/paper/watermark/toolbar/hideRows/hideCols）", "widthPt/format/heightsPt 透传"],
      "unsupported": ["chart", "filters", "sort", "topN", "join", "dataset.query.type=semantic", "非 sum 聚合"]
    },
    "sql": {
      "supported": ["Semantic Model 维度/指标（不受自由文本 SQL）", "dateRange", "dataset.filters", "sort", "topN", "presentation.chart bar|pie|line|Van 族(vbar/vline/varea/vscatter/vbubble/vpie/vgauge)+装饰键", "params 参数面板", "sheet 扩展（同 rows）", "confirmed 安全关系(N:1/1:1，目标键机器验证唯一) INNER JOIN"],
      "unsupported": ["自由文本 dataset.query（§5.2）", "跨表度量（JOIN 不改 grain）", "非安全基数 join（1:N/N:M）", "presentation.conditions/cells/total（sql 路不发射）"]
    },
    "multiSheet": "后端 IR 支持多 sheet；ReportSpec/Planner 尚无入口（unsupported）",
    "entrypoint": "REPORT_SPEC=<path>.json run.ps1 make_api.js — make_api.js §0 后缀分支：JSON.parse→SpecValidator→SpecCompiler→SPEC={outName,IR} 复用 rawIR 直通路；旧 .js spec 走原 load() 路径不变"
  }
}
